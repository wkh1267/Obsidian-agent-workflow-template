#!/bin/sh
# .githooks/pre-commit — invoke the PowerShell orchestrator.
# Activated via: git config core.hooksPath .githooks
SCRIPT="$(git rev-parse --show-toplevel)/vault/.claude/hooks/pre-commit.ps1"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
else
  exec powershell -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
fi
